# ===========================================
# SiteProof — AI Web Quality & Audit Engine
# Environment Variables
# ===========================================

# --- Supabase ---
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Google PageSpeed Insights API (client-side, safe to expose) ---
# Get your key: https://developers.google.com/speed/docs/insights/v5/get-started
VITE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# --- Google OAuth ---
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# --- App Configuration ---
VITE_APP_NAME=SiteProof
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# =====================================================================
# SERVER-SIDE ONLY — Set these in the Netlify dashboard
# (Site > Environment Variables). They run inside Netlify Functions
# and are NEVER exposed to the browser.
# =====================================================================
#
# NVIDIA_API_KEY=your_nvidia_api_key_here
#   Get your key: https://build.nvidia.com/
#
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
#   The NVIDIA NIM model to use for AI analysis
#
# GITHUB_TOKEN=your_github_personal_access_token_here
#   Optional but STRONGLY recommended. Without it, GitHub API is
#   limited to 60 requests/hour. With it: 5,000 requests/hour.
#   Create one: https://github.com/settings/tokens
#   Scopes needed: repo (read-only)
